# admin-ui — currency-api'nin anahtar yönetimi arayüzü.
#
# Ana projeden (currency-api) TAMAMEN bağımsız bir deployable: kendi imajı, kendi yaşam
# döngüsü. Sunucu tarafında dinamik iş yok (tüm çağrılar tarayıcıdan doğrudan admin API'ye
# gider), bu yüzden ağır bir runtime yerine yalnız statik dosya sunan nginx:alpine yeterli.

FROM node:22-alpine AS build
WORKDIR /workspace
COPY package*.json ./
RUN npm ci
COPY . .
RUN npx ng build

FROM nginx:alpine
COPY --from=build /workspace/dist/admin-ui/browser /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
