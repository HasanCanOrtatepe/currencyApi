# Pair 3 Sunum sunucusu — şablon. Gerçek değerler `sunum/.env` içine yazılır ve o dosya
# GITIGNORE'LUDUR. Paylaşılmış (sohbet/ekran görüntüsü/PR) bir şifre YANMIŞ sayılır.
#
#   cp sunum/.env.example sunum/.env   ve aşağıyı doldur

# Desteyi açacak ŞİFRE. Ekiple paylaşılır.
#
# Sunucu şifresiz AÇILMAZ ve 8 karakterden kısa şifreyle de açılmaz: bu yüzey tünel
# üzerinden internete çıkar ve insan seçimi bir şifre kaba kuvvete açıktır. Üretmek için:
#
#   openssl rand -base64 12
#
# Sunum günü ekibe okunabilir bir şey vermek istersen 4+ kelimeli bir öbek kullan
# ("turuncu-devre-kesici-2026" gibi) — kısa ve akıllı bir şifreden her zaman daha güçlüdür.
SUNUM_SIFRE=

# Oturum çerezini imzalayan anahtar. BOŞ BIRAKILABİLİR: o zaman her açılışta rastgele
# üretilir ve konteyner yeniden başlatıldığında herkes tekrar şifre girer.
#
# SUNUM GÜNÜ İÇİN DOLDURMAK ÖNERİLİR: sahnede bir yeniden başlatma olursa kimsenin tekrar
# şifre girmesi gerekmez. Üretmek için:
#
#   openssl rand -hex 32
SUNUM_CEREZ_ANAHTARI=

# Şifre denemesi sayacının kimliğini taşıyan başlık.
#
# Tünel arkasında socket adresi TÜM internet trafiği için AYNIDIR (kur servisinde ölçüldü:
# remote=10.89.0.3). O hâliyle "deneme sayısı IP başına" cümlesi "tek kova, tüm dünya"
# demektir ve tek bir kaba kuvvet denemesi, sunumdan beş dakika önce EKİBİ kilitler.
# cloudflared bu başlığı KENDİSİ yazar, tünelden geçen istemci uyduramaz.
#
# Portu doğrudan güvenilmeyen bir ağa açan bir kurulumda başlık uydurulabilir; ona karşı
# ikinci katman sunucudaki küresel deneme tavanıdır.
SUNUM_IP_BASLIGI=cf-connecting-ip
