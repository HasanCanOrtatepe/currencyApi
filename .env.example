# currency-api — kalıcı sunucu kurulumu için ortam değişkenleri şablonu
#
#   cp .env.example .env      # ve gerçek değerleri .env'e yaz
#   podman compose up -d --build
#
# `.env` .gitignore'ludur; bu şablon izlenir ve GİZLİ DEĞER İÇERMEZ.
# Paylaşılan (sohbet/ekran görüntüsü/PR) bir anahtar YAKILMIŞ sayılır: yenisi üretilir.

# Tanınan anahtarlar: "anahtar=tuketici,anahtar2=tuketici2"
# Değeri siz üretirsiniz (rastgele ve uzun olsun):  openssl rand -hex 24
# Tüketici adı yalnız log/metrik içindir — "hangi tüketici kotayı doldurdu" sorusu anahtarla
# değil adla cevaplanmalıdır, çünkü anahtar loglara girmez.
CURRENCY_API_KEYS=

# Anahtar doğrulaması. Kalıcı sunucuda varsayılan AÇIK: 8095 makinenin ağ arayüzünde durur.
CURRENCY_AUTH_ENABLED=true

# Tüketici başına dakikalık kota. Cache'ini kullanan bir tüketici saatte ~4 istek atar ve bu
# sınıra yaklaşmaz; sınır, cache'i devre dışı kalan ya da döngüye giren tüketici içindir.
# CURRENCY_RATE_LIMIT=120

# ANONİM isteğin adresini taşıyan başlık — kotanın kime yazılacağını belirler.
# compose bunu CF-Connecting-IP olarak verir: tünel arkasında konteynere gelen bağlantının
# kaynağı TÜM internet trafiği için aynıdır, yani başlıksız kurulumda anahtarsız önizleme
# ucunun kotası tek bir kovadır ve tek çağıran onu herkes adına tüketebilir.
# Bu portu tünelsiz olarak güvenilmeyen bir ağa açacaksanız BOŞ BIRAKIN: orada başlık
# uydurulabilir ve sınır her istekte yeni bir kimlikle atlatılabilir.
# CURRENCY_CLIENT_IP_HEADER=CF-Connecting-IP

# Dışarı açılan actuator uçları. VARSAYILAN YALNIZ health'tir ve public instance'ta öyle
# KALMALIDIR: /actuator/metrics anahtarsız çağrıldığında JDK sürümünü, disk/CPU bilgisini ve
# tüm uç listesini verir. compose bunu yalnız loopback'e bağlı admin instance'ında genişletir.
# CURRENCY_ACTUATOR_EXPOSE=health

# Boş bırakılırsa gerçek TCMB kullanılır. Yalnız tüketici testlerinde değiştirilir.
# TCMB_BASE_URL=

# EVDS (TCMB Elektronik Veri Dağıtım Sistemi) anahtarı — kur zincirinin İLK basamağı.
# https://evds2.tcmb.gov.tr üzerinden ücretsiz üyelikle alınır (Profil > API Anahtarı).
#
# NE KAZANDIRIR: today.xml ile aynı kurumun aynı resmî satış kurudur, sayılar birebir aynıdır.
# Kazanılan şey DOĞRU TARİHTİR: today.xml'in Tarih özniteliği bir gün geriden gelir (14.08
# sabahı yayınlanan belge "13.08" der), EVDS her satırı kendi günüyle verir.
#
# BOŞ BIRAKILABİLİR: o zaman EVDS zincire hiç girmez, servis yalnız today.xml kullanır ve
# hiçbir şey bozulmaz — yalnız vitrinde bülten tarihi bir gün geriden gelir. Anahtar varsa da
# EVDS düştüğünde zincir kendiliğinden today.xml'e iner; tek bir anahtar servisi düşüremez.
CURRENCY_EVDS_KEY=

# ECB (Avrupa Merkez Bankası) — kur zincirinin SON basamağı ve tek BAĞIMSIZ kaynağı.
# Anahtar İSTEMEZ, ücretsizdir: https://www.ecb.europa.eu/stats/eurofxref/eurofxref-daily.xml
#
# NE KAZANDIRIR: EVDS ile today.xml aynı KURUMUN iki kapısıdır — o kurum erişilemez olduğunda
# (bakım, kesinti, ağ yolu) ikisi birden düşer ve elimizde yalnız kendi bayat kurumuz kalır.
# ECB farklı bir kurum, farklı altyapı, farklı ülkedir; birlikte düşmeleri için ortak bir
# sebep yoktur. Kapatılan şey budur: TCMB'nin tek nokta arızası olması.
#
# NE KAZANDIRMAZ: hafta sonunu. ECB de hafta sonu/tatilde yayın yapmaz. Yayın boşluğunun
# cevabı cache'in 7 günlük SAKLAMA penceresidir (son geçerli kur), bu sağlayıcı değil.
#
# AÇILDIĞINDA NE DEĞİŞİR: TCMB'nin iki yoluna da ulaşılamayan bir günde sunulan kur ECB'nin
# REFERANS kuru olur — TCMB'nin resmî SATIŞ kuruyla yakın ama aynı sayı değildir. Bu gizlenmez:
# cevapta provider alanı "ecb" yazar. Yine de bir davranış değişikliği olduğu için varsayılan
# KAPALIDIR; açmak bilinçli bir karardır (CURRENCY_AUTH_ENABLED ile aynı ilke).
CURRENCY_ECB_ENABLED=true

# Boş bırakılırsa gerçek ECB kullanılır. Yalnız tüketici testlerinde değiştirilir.
# CURRENCY_ECB_BASE_URL=

# Sahte satıcı yüzü (/kurlar/**, /stats/**) ve kaos uçları (/__mode, /__settings, /__reset).
# VARSAYILAN KAPALI ve internete açık bir kurulumda KAPALI KALMALIDIR: kaos uçları kimlik
# doğrulaması istemez ve durum değiştirir — açık bırakılırsa uzaktan erişilebilir bir arıza
# düğmesi olur. Yalnız tüketici dayanıklılık testlerinde açılır.
# CURRENCY_SIMULATOR_ENABLED=true

# Admin API (/admin/keys) — anahtar yönetimi (oluştur/listele/iptal, restart'sız).
# Varsayılan KAPALI, ayrı bir portta çalışır (CURRENCY_ADMIN_PORT) — tunnel bu portu
# yönlendirmez, dolayısıyla internetten yapısal olarak erişilemez. Port ayrıca YALNIZ
# loopback'e (127.0.0.1) bağlanır: makine güvenilmeyen bir Wi-Fi'a bağlandığında panel o
# ağa açılmasın diye. Başka cihazdan yönetim için SSH tüneli kullanılır.
# Redis kesintisinde dinamik anahtarlar 401 alır (fail-CLOSED, statik anahtarların aksine) —
# Redis kesintisinde ayakta kalması gereken bir tüketiciye dinamik değil statik anahtar verin.
# CURRENCY_ADMIN_ENABLED=true
# Rastgele ve uzun: openssl rand -hex 32
# CURRENCY_ADMIN_TOKEN=
# CURRENCY_ADMIN_PORT=8097

# Admin panelinin origin'i (CORS) — yalnız panelin portunu değiştirirseniz gerekir.
# Panel loopback'e bağlıdır; iki yazım da listede olmalıdır çünkü tarayıcıya localhost da
# 127.0.0.1 de yazılabilir ve Origin başlığında hangisi yazıldıysa o gider.
# CURRENCY_ADMIN_CORS_ORIGIN_PATTERN=http://localhost:8096,http://127.0.0.1:8096

# Not: CURRENCY_CACHE_TYPE, REDIS_HOST ve REDIS_PORT değerlerini podman-compose.yml
# doğrudan verir; buradan ayarlanmaları gerekmez.
