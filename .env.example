# currency-api — kalıcı sunucu kurulumu için ortam değişkenleri şablonu
#
#   cp .env.example .env      # ve gerçek değerleri .env'e yaz
#   podman compose up -d --build
#
# `.env` .gitignore'ludur; bu şablon izlenir ve GİZLİ DEĞER İÇERMEZ.
# Paylaşılan (sohbet/ekran görüntüsü/PR) bir anahtar YAKILMIŞ sayılır: yenisi üretilir.

# Tanınan anahtarlar: "anahtar=tuketici,anahtar2=tuketici2"
# Değeri siz üretirsiniz (rastgele ve uzun olsun):  openssl rand -hex 24
# Tüketici adı yalnız log/metrik içindir — "hangi tüketici kotayı doldurdu" sorusu anahtarla
# değil adla cevaplanmalıdır, çünkü anahtar loglara girmez.
CURRENCY_API_KEYS=

# Anahtar doğrulaması. Kalıcı sunucuda varsayılan AÇIK: 8095 makinenin ağ arayüzünde durur.
CURRENCY_AUTH_ENABLED=true

# Tüketici başına dakikalık kota. Cache'ini kullanan bir tüketici saatte ~4 istek atar ve bu
# sınıra yaklaşmaz; sınır, cache'i devre dışı kalan ya da döngüye giren tüketici içindir.
# CURRENCY_RATE_LIMIT=120

# Boş bırakılırsa gerçek TCMB kullanılır. Yalnız tüketici testlerinde değiştirilir.
# TCMB_BASE_URL=

# Admin API (/admin/keys) — anahtar yönetimi (oluştur/listele/iptal, restart'sız).
# Varsayılan KAPALI, ayrı bir portta çalışır (CURRENCY_ADMIN_PORT) — tunnel bu portu
# yönlendirmez, dolayısıyla internetten yapısal olarak erişilemez; yalnız LAN'a açıktır.
# Redis kesintisinde dinamik anahtarlar 401 alır (fail-CLOSED, statik anahtarların aksine) —
# Redis kesintisinde ayakta kalması gereken bir tüketiciye dinamik değil statik anahtar verin.
# CURRENCY_ADMIN_ENABLED=true
# Rastgele ve uzun: openssl rand -hex 32
# CURRENCY_ADMIN_TOKEN=
# CURRENCY_ADMIN_PORT=8097
